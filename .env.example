# Perfil Spring
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (perfil dev)
DB_URL=jdbc:postgresql://localhost:5432/acoes_corretoradb
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=acoes_corretoradb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433
BACKEND_PORT=8081
FRONTEND_PORT=8082

# APIs externas (necessarias para consultar cotacoes BR e US)
BRAPI_TOKEN=
ALPHAVANTAGE_API_KEY=

# MySQL (perfil mysql)
MYSQL_URL=jdbc:mysql://localhost:3306/acoes_corretoradb?createDatabaseIfNotExist=true&serverTimezone=America/Sao_Paulo
MYSQL_USER=root
MYSQL_PASSWORD=

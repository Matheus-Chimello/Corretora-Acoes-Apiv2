{
  "info": {
    "name": "API Gestao de Acoes e Corretoras",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "investorToken", "value": "" },
    { "key": "corretoraId", "value": "" },
    { "key": "acaoId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@corretora.local\",\n  \"password\": \"admin123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('adminToken', body.token);"] } }]
        },
        {
          "name": "Registrar usuario",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nova Conta\",\n  \"email\": \"nova.conta@exemplo.com\",\n  \"password\": \"senha123\",\n  \"confirmPassword\": \"senha123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login investidor",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario@corretora.local\",\n  \"password\": \"user123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('investorToken', body.token);"] } }]
        }
      ]
    },
    {
      "name": "Corretoras",
      "item": [
        {
          "name": "Cadastrar corretora",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cnpj\": \"02.332.886/0001-04\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/corretoras"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('corretoraId', pm.response.json().id);"] } }]
        },
        { "name": "Listar corretoras", "request": { "method": "GET", "url": "{{baseUrl}}/corretoras" } },
        { "name": "Buscar corretora por ID", "request": { "method": "GET", "url": "{{baseUrl}}/corretoras/{{corretoraId}}" } },
        { "name": "Buscar corretora por CNPJ", "request": { "method": "GET", "url": "{{baseUrl}}/corretoras/cnpj/02332886000104" } }
      ]
    },
    {
      "name": "Acoes",
      "item": [
        {
          "name": "Cadastrar acao",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ticker\": \"PETR4\",\n  \"mercado\": \"BR\",\n  \"corretoraId\": \"{{corretoraId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/acoes"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('acaoId', pm.response.json().id);"] } }]
        },
        { "name": "Listar acoes", "request": { "method": "GET", "url": "{{baseUrl}}/acoes" } },
        { "name": "Buscar acao por ID", "request": { "method": "GET", "url": "{{baseUrl}}/acoes/{{acaoId}}" } },
        { "name": "Buscar acao por ticker", "request": { "method": "GET", "url": "{{baseUrl}}/acoes/ticker/PETR4" } },
        { "name": "Atualizar cotacao", "request": { "method": "PUT", "url": "{{baseUrl}}/acoes/{{acaoId}}/atualizar-cotacao" } },
        {
          "name": "Minhas posicoes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{investorToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/acoes/minhas"
          }
        },
        {
          "name": "Comprar para minha carteira",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{investorToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantidade\": 2\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/acoes/{{acaoId}}"
          }
        },
        {
          "name": "Vender da minha carteira",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{investorToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantidade\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/acoes/PETR4"
          }
        }
      ]
    },
    {
      "name": "Carteira do investidor",
      "item": [
        {
          "name": "Realizar aporte",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{investorToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"valor\": 1000\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/carteiras/principal/aportes"
          }
        }
      ]
    }
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="020-revogar-sessoes-de-contas-inativas" author="matheus">
        <addColumn tableName="usuarios">
            <column name="versao_sessao" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="usuarios">
            <column name="versao_sessao" valueNumeric="1"/>
            <where>ativo = FALSE</where>
        </update>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="023-separar-saldos-por-moeda" author="matheus">
        <addColumn tableName="carteira">
            <column name="saldo_em_dolar" type="NUMERIC(38,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="transacoes_carteira">
            <column name="moeda" type="VARCHAR(3)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
